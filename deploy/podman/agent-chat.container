[Unit]
Description=Agent Chat HTTP API, SSE feed and browser UI
After=network-online.target agent-chat-migrate.service
Wants=network-online.target
Requires=agent-chat-migrate.service

[Container]
Image=localhost/agent-chat-server:local
ContainerName=agent-chat
Exec=serve --config /etc/agent-chat/config.json
Environment=CREDENTIALS_DIRECTORY=/run/secrets
Secret=agent-chat-dsn,type=mount,target=agent-chat-dsn,uid=10001,gid=10001,mode=0400
Volume=/etc/agent-chat/server.json:/etc/agent-chat/config.json:ro
Network=agent-chat.network
Network=traefik
User=10001:10001
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=16m
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8443/healthz', timeout=2)"
HealthInterval=10s
HealthTimeout=3s
HealthStartPeriod=10s
HealthRetries=6
StopTimeout=30

[Service]
Restart=on-failure
TimeoutStartSec=900

[Install]
WantedBy=default.target
