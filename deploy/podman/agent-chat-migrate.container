[Unit]
Description=Agent Chat one-shot schema migration
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/agent-chat-server:local
ContainerName=agent-chat-migrate
Exec=migrate --config /etc/agent-chat/config.json
Environment=CREDENTIALS_DIRECTORY=/run/secrets
Secret=agent-chat-dsn,type=mount,target=agent-chat-dsn,uid=10001,gid=10001,mode=0400
Volume=/etc/agent-chat/server.json:/etc/agent-chat/config.json:ro
Network=agent-chat.network
User=10001:10001
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=16m
# The root filesystem is read-only, and crun 1.31 or later and runc 1.5.2 cannot
# create the secret's mount point in it; this tmpfs provides one.
Tmpfs=/run/secrets:rw,noexec,nosuid,size=1m,mode=0755
DropCapability=ALL
NoNewPrivileges=true
StopTimeout=30

[Service]
Type=oneshot
RemainAfterExit=yes
# `migrate` waits for a late database for up to MIGRATE_WAIT_SECONDS (agent_chat/admin.py). A one-shot unit has no
# start limit unless it sets one; this limit stays above that wait. tests/test_deploy.py pins the relation.
TimeoutStartSec=360

[Install]
WantedBy=default.target
