[Unit]
Description=Agent Chat one-shot schema migration
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/agent-chat-server:local
ContainerName=agent-chat-migrate
Exec=migrate --config /etc/agent-chat/config.json
Environment=CREDENTIALS_DIRECTORY=/run/secrets
Secret=agent-chat-dsn,type=mount,target=agent-chat-dsn,uid=10001,gid=10001,mode=0400
Volume=/etc/agent-chat/server.json:/etc/agent-chat/config.json:ro
Network=agent-chat.network
User=10001:10001
ReadOnly=true
Tmpfs=/tmp:rw,noexec,nosuid,size=16m
DropCapability=ALL
NoNewPrivileges=true
StopTimeout=30

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=default.target
