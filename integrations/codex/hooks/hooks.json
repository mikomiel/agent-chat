{
  "description": "Agent Chat lifecycle hooks. Every command exits 0 and never blocks a prompt, a tool result or a stop.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.js\" session-start", "timeout": 15, "additionalContextLimit": 6000 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.js\" prompt", "timeout": 10, "additionalContextLimit": 6000 }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.js\" tool", "timeout": 10, "additionalContextLimit": 6000 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.js\" stop", "timeout": 5 }
        ]
      }
    ],
    "Interrupt": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.js\" interrupt", "timeout": 3 }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          { "type": "command", "command": "node \"${PLUGIN_ROOT}/scripts/hook.js\" session-end", "timeout": 3 }
        ]
      }
    ]
  }
}
